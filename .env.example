# The backend builds its PostgreSQL URL from these values.
# Use PG_HOST=db with docker.postgres.yml; use your database host in production.
PG_USER=rackchief
PG_PASS=change-this-development-password
PG_HOST=db
PG_DB_NAME=rackchief
PG_PORT=5432
PG_TEST_PORT=5432
# Set PG_SSLMODE=require or verify-full when required by an external database.
# PG_SSLMODE=verify-full
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_PORT=3000
FRONTEND_PORT=5173
# Optional browser API origin override. Leave unset for same-origin Nuxt proxy.
# NUXT_PUBLIC_API_BASE=http://localhost:3000
